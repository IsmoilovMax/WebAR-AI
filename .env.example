# ---------------------------------------------------------------------------
# Umumiy sozlamalar. Nusxa oling: cp .env.example .env
# ---------------------------------------------------------------------------

# --- Postgres / TimescaleDB ---
POSTGRES_USER=acs
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=acs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://acs:change-me-in-production@localhost:5432/acs

# --- Redis (event bus) ---
REDIS_URL=redis://localhost:6379/0
EVENT_STREAM_KEY=acs:events
FEEDBACK_STREAM_KEY=acs:feedback

# --- MinIO / S3 (snapshot va kliplar) ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=acs-minio
S3_SECRET_KEY=change-me-in-production
S3_BUCKET=acs-media
S3_REGION=us-east-1

# --- go2rtc (RTSP -> WebRTC gateway) ---
GO2RTC_URL=http://localhost:1984
NEXT_PUBLIC_GO2RTC_URL=http://localhost:1984

# Jonli video va AI tahlil oqimi: main (sifatli) yoki sub (12 kamera grid)
ACS_LIVE_STREAM=main
# AI tahlil — sub tezroq; box lar main video ustiga mos (normallashtirilgan)
ACS_AI_STREAM=sub

# Demografiya: InsightFace buffalo_sc (RetinaFace + ArcFace). false = YOLO face.
ACS_INSIGHTFACE=true
ACS_INSIGHTFACE_PACK=buffalo_sc
ACS_ARCFACE_THRESHOLD=0.42
# Bir xil odam kuniga 1 hodisa — kun chegarasi (timezone)
ACS_DAY_TZ=Asia/Seoul

# --- AI worker ---
AI_WORKER_URL=http://localhost:8000
AI_WORKER_TOKEN=change-me-in-production

# Tashqi React/Node sayt BFF uchun (WHEP proksi).
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACS_SERVICE_TOKEN=

# Kamera credentials shifrlash kaliti (32 bayt, base64).
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Next.js ---
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Alert kanallari ---
TELEGRAM_BOT_TOKEN=
SMTP_URL=

# --- Roboflow (active learning) ---
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=

# --- Retention (kun) ---
MEDIA_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=180
